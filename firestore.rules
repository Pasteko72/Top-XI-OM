rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per fan: votes/{uid} = { t: {playerId: [wins, losses]}, n: totalVotes, at: serverTime }
    match /votes/{uid} {
      allow read: if true;
      allow create: if signedInAs(uid) && valid() && request.resource.data.n <= 300;
      allow update: if signedInAs(uid) && valid()
        // at most one save every 2 seconds, adding at most 60 votes
        && request.time > resource.data.at + duration.value(2, 's')
        && request.resource.data.n >= resource.data.n
        && request.resource.data.n <= resource.data.n + 60;
      allow delete: if signedInAs(uid);
    }
    function signedInAs(uid) { return request.auth != null && request.auth.uid == uid; }
    function valid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['t', 'n', 'at'])
        && d.t is map && d.t.size() <= 300
        && d.n is int && d.n >= 0
        && d.at == request.time;
    }
  }
}
